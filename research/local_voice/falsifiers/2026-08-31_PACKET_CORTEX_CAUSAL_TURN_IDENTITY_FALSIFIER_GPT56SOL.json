  "purpose": "Falsify causal ownership, idempotency, cancellation, replay/reorder handling, restart behavior, and VoiceOutcome re-entry using deterministic information packets only.",
  "oracle_law": [
    "A packet may affect only the session/turn/epoch it is causally admitted to.",
    "A duplicate/replayed packet must never cause a second semantic admission, tool effect, memory write, spoken-output commit, or VoiceOutcome commit.",
    "A cancelled or stale producer may not regain authority through a late result.",
    "Final input cannot be semantically rolled back by a late older partial.",
    "Unheard output must not be committed as heard/spoken; partial heard state must remain quantitatively bounded.",
    "Restart may restore only admitted durable state and may not resurrect cancelled output or stale in-flight ownership.",
    "Session identity is part of causal identity; equal turn_id values across sessions are not interchangeable.",
    "Corrupt, impossible, or policy-ambiguous packet order must fail closed or enter an explicit noncanonical quarantine/buffer state; silent canonical mutation is forbidden."
  ],
  "trace_defaults": {
    "source_modality": "SIMULATED_TEXT_PACKET",
    "language_locale": "de-DE",
    "outbound_model_asr_tts_inference_calls": 0,
    "clock": "deterministic_monotonic_fixture",
    "acoustic_claims": false
  },
