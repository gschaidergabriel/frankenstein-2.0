{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "FRANKENSTEIN2_IMMUTABLE_RUN_PACKAGE/v1",
  "title": "Frankenstein 2.0 immutable per-test run package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "package_id",
    "workpackage_id",
    "generation",
    "source_identity",
    "claim_scope",
    "runtime_credit_ceiling",
    "command",
    "outcome",
    "started_at",
    "completed_at",
    "provider_calls",
    "paid_spend_usd",
    "external_effects_executed",
    "files",
    "package_digest"
  ],
  "properties": {
    "schema": {"const": "FRANKENSTEIN2_IMMUTABLE_RUN_PACKAGE/v1"},
    "package_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "workpackage_id": {"type": "string", "pattern": "^F2-WP-[0-9]{3,4}$"},
    "generation": {"type": "integer", "minimum": 0},
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit_sha", "tree_sha"],
      "properties": {
        "repository": {"type": "string", "minLength": 3},
        "ref": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "claim_scope": {"type": "string", "minLength": 1, "maxLength": 240},
    "runtime_credit_ceiling": {"type": "string", "minLength": 1, "maxLength": 240},
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "outcome": {
      "enum": ["PASS", "FAIL", "BLOCKED", "INFRA_FAILURE", "NOT_RUN"]
    },
    "started_at": {"type": ["string", "null"]},
    "completed_at": {"type": ["string", "null"]},
    "exit_code": {"type": ["integer", "null"]},
    "provider_calls": {"type": "integer", "minimum": 0},
    "paid_spend_usd": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "external_effects_executed": {"type": "boolean"},
    "runner_identity": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "authority_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
      },
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "notes": {"type": "array", "items": {"type": "string"}},
    "package_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
