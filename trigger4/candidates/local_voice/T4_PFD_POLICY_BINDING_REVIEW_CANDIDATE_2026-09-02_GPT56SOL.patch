+    def emit_turn_policy_intent(self, *, packet: VoiceInputPacket,
+                                monotonic_ms: int) -> CortexEventPacket:
+        """Emit one deterministic policy-conditioned intent for an already admitted input.
+
+        The packet content/timing is held fixed between policy arms.  Only the immutable
+        PacketTurnPolicy may change.  This method does not perform model or network I/O.
+        """
+        if not self.is_open or type(packet) is not VoiceInputPacket or packet.session_id != self.session_id:
+            raise VoicePacketCortexError("closed session or policy packet session/type mismatch")
+        _nonnegative("monotonic_ms", monotonic_ms)
+        if monotonic_ms < packet.monotonic_ms:
+            raise VoicePacketCortexError("policy decision cannot precede admitted input packet")
+        admitted_digest = self._input_seen.get(packet.packet_id)
+        if admitted_digest is None or admitted_digest != packet.sha256():
+            raise VoicePacketCortexError("policy decision requires the exact already admitted input packet")
+
+        backchannel = (
+            self.turn_policy.backchannel_mode == "ON_NONFINAL_HOLD"
+            and not packet.is_final
+            and packet.endpoint_decision == "HOLD"
+            and packet.vad_state == "SPEECH"
+            and packet.overlap_state == "NONE"
+        )
+        voice_intent = "BACKCHANNEL" if backchannel else "WAIT"
+        return self._event(
+            turn_id=packet.turn_id,
+            monotonic_ms=monotonic_ms,
+            kind="VOICE_INTENT",
+            intent=voice_intent,
+            packet_refs=(packet.packet_id,),
+            detail=(
+                f"turn_policy_id={self.turn_policy.policy_id};"
+                f"turn_policy_sha256={self.turn_policy.sha256()};"
+                f"backchannel_mode={self.turn_policy.backchannel_mode}"
+            ),
+        )
 
