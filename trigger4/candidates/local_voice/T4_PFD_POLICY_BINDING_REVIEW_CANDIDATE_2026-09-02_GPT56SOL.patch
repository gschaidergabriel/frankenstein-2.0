+    def test_policy_only_matched_history_diverges_wait_vs_backchannel(self) -> None:
+        never = PacketTurnPolicy(policy_id="policy:pfd-never", backchannel_mode="NEVER")
+        on_hold = PacketTurnPolicy(policy_id="policy:pfd-on-hold", backchannel_mode="ON_NONFINAL_HOLD")
+
+        left = VoicePacketCortex(self.session(), turn_policy=never)
+        right = VoicePacketCortex(self.session(), turn_policy=on_hold)
+        left_packet = self.input_packet(left)
+        right_packet = self.input_packet(right)
+
+        left.accept_input(left_packet)
+        right.accept_input(right_packet)
+        left_pre = tuple(event.as_dict() for event in left.events)
+        right_pre = tuple(event.as_dict() for event in right.events)
+        self.assertEqual(left_pre, right_pre)
+        self.assertEqual(left_packet.as_dict(), right_packet.as_dict())
+
+        left_event = left.emit_turn_policy_intent(packet=left_packet, monotonic_ms=101)
+        right_event = right.emit_turn_policy_intent(packet=right_packet, monotonic_ms=101)
+        self.assertEqual(left_event.event_kind, "VOICE_INTENT")
+        self.assertEqual(right_event.event_kind, "VOICE_INTENT")
+        self.assertEqual(left_event.packet_refs, right_event.packet_refs)
+        self.assertEqual(left_event.monotonic_ms, right_event.monotonic_ms)
+        self.assertEqual(left_event.voice_intent, "WAIT")
+        self.assertEqual(right_event.voice_intent, "BACKCHANNEL")
+        self.assertIn(never.sha256(), left_event.detail)
+        self.assertIn(on_hold.sha256(), right_event.detail)
